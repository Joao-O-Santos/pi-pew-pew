{
  "name": "pi-pew-pew",
  "version": "0.5.1",
  "description": "Read-only cached web retrieval and authenticated Chromium inspection for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/Joao-O-Santos/pi-pew-pew.git"
  },
  "bugs": {
    "url": "https://gitlab.com/Joao-O-Santos/pi-pew-pew/-/issues"
  },
  "homepage": "https://gitlab.com/Joao-O-Santos/pi-pew-pew",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "web",
    "exa",
    "chromium"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "test:exa": "node --import tsx --test test/exa.smoke.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false .",
    "format:fix": "biome check --write .",
    "markdown:check": "node scripts/format-markdown.mjs",
    "markdown:fix": "node scripts/format-markdown.mjs --write",
    "style": "npm run lint && npm run format:check && npm run markdown:check",
    "check": "npm run typecheck && npm run style && npm test"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "robots-parser": "^3.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typebox": "1.3.7",
    "typescript": "^5.9.3"
  }
}
